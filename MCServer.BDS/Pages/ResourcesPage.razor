@using System.ComponentModel
@using MCServer.BDS.Models
@using MCServer.BDS.Services
@using MCServer.Plugins
@using MCServer.BDS.Dialogs
@using Microsoft.JSInterop
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>@(Server?.Settings.Name ?? "MCServer") - Resources</PageTitle>

<style>
    .list-page-layout {
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 16px;
    }

    .list-page {
        width: 360px;
        flex-shrink: 0;
        height: 100%;
    }

    .list-page-detail {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        overflow: auto;
    }

    .list-page-overlay {
        position: absolute;
        inset: 0;
        background: var(--mud-palette-background);
        z-index: 10;
        overflow: auto;
    }

    @@media (max-width: 959.98px) {
        .list-page {
            width: 100%;
        }
    }
</style>

<div style="position: relative; height: 100%;">
    @if (MissingStock.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense Class="mb-2">
            Server install is damaged — missing: @string.Join(", ", MissingStock).
            BDS cannot start worlds without the stock packs (it quits with
            "Failed to load Vanilla Resource Pack"). Re-extract them from the
            Bedrock server .zip (resource_packs/, behavior_packs/, definitions/).
        </MudAlert>
    }
    <div class="list-page-layout">
        <MudStack Spacing="3" Class="list-page" Style="height: 100%;">
            <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable
                          Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search"
                          OnAdornmentClick="@Refresh" TextChanged="@(s => Search(s))">
            </MudTextField>

            <MudList T="WorldInfo" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="SelectedWorld"
                     Style="overflow:auto; height:100%">
                @foreach (var world in Worlds)
                {
                    <MudListItem Value="@world">
                        <ChildContent>
                            <MudStack Spacing="1" Row AlignItems="AlignItems.Center">
                                <MudChip Color="@(world.Name == ActiveWorldName ? Color.Success : Color.Secondary)"
                                         Text="@(world.Name == ActiveWorldName ? "Active" : "Idle")" />

                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">@world.Name</MudText>
                                    <MudText Typo="Typo.body2">
                                        Size: @Plugins.OtherHelpers.FormatSize(world.SizeBytes)
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        Modified: @world.LastModified.ToLocalTime()
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>

            <MudFileUpload T="IBrowserFile" FilesChanged="ImportWorld" Accept=".zip,.tar.gz,.tgz,.mcworld"
                           MaximumFileCount="1" Disabled="@Busy">
                <CustomContent>
                    <MudButtonGroup Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth>
                        <MudButton StartIcon="@Icons.Rounded.Add" Disabled="@Busy" OnClick="CreateWorldAsync">
                            Create
                        </MudButton>
                        <MudButton StartIcon="@Icons.Rounded.CloudDownload" OnClick="@context.OpenFilePickerAsync">
                            Import
                        </MudButton>
                    </MudButtonGroup>
                </CustomContent>
            </MudFileUpload>
        </MudStack>

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudDivider Vertical />
        </MudHidden>

        <div class="list-page-detail">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <ResourcesDisplayPage Server="@Bedrock" @bind-World="SelectedWorld"
                                      @bind-ActiveWorldName="ActiveWorldName" @bind-Busy="Busy" @bind-BusyMessage="BusyMessage"
                                      OnStateHasChanged="StateHasChanged" Refresh="Refresh" OnSelectWorld="SelectWorldAsync" />
            </MudHidden>
        </div>
    </div>

    @if (SelectedWorld != default)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="list-page-overlay">
                <ResourcesDisplayPage Server="@Bedrock" @bind-World="SelectedWorld" @bind-ActiveWorldName="ActiveWorldName"
                                      @bind-Busy="Busy" @bind-BusyMessage="BusyMessage" OnStateHasChanged="StateHasChanged" Refresh="Refresh"
                                      OnSelectWorld="SelectWorldAsync" ShowBack />
            </div>
        </MudHidden>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IGameServer Server { get; set; } = null!;

    private BedrockServer Bedrock => (BedrockServer)Server;

    private IGameServer? _loadedServer;

    public ObservableCollection<WorldInfo> WorldsList = [];
    public ExList<WorldInfo> Worlds;
    public List<string> MissingStock = [];
    public string SearchText { get; set; } = string.Empty;
    public WorldInfo? SelectedWorld = default;
    public string? ActiveWorldName = default;
    private string NewWorldName = "";

    public bool Busy { get; set; } = default;
    public string BusyMessage { get; set; } = string.Empty;

    public ResourcesPage()
    {
        Worlds = new(WorldsList);
        Worlds.SetSort((a, b) => string.Compare(a.DisplayName, b.DisplayName, StringComparison.OrdinalIgnoreCase));
        Worlds.SetFilter(filter =>
        {
            if (string.IsNullOrWhiteSpace(SearchText)) return true;
            return filter.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                filter.DisplayName.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
        });
    }

    /// <summary>Reloads when the <c>Server</c> parameter changes (same page reused for another server).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedServer, Server)) return;
        _loadedServer = Server;
        SelectedWorld = default;
        Refresh();
    }

    private void Refresh()
    {
        var selectedName = SelectedWorld?.Name;
        WorldsList.Clear();
        WorldsList.AddRange(Bedrock.GetWorlds());
        Worlds.RefreshFilter();
        MissingStock = Bedrock.GetMissingStockContent();
        //SelectedWorld = Worlds.FirstOrDefault(w => w.Name == selectedName) ?? Worlds.FirstOrDefault();
        ActiveWorldName = Bedrock.GetProperties().FirstOrDefault(p => p.Name == "level-name")?.Value;
        StateHasChanged();
    }

    private void Search(string value)
    {
        SearchText = value;
        Worlds.RefreshFilter();
        StateHasChanged();
    }

    private void SetLevelName(string name)
    {
        var props = Bedrock.GetProperties();
        var matches = props.Where(p => p.Name.Equals("level-name", StringComparison.OrdinalIgnoreCase)).ToList();
        if (matches.Count == 0)
            props.Add(new Property("level-name", name, ["# The name of the level (world folder)."]));
        else
            matches.ForEach(p => p.Value = name);
        Bedrock.SetProperties(props);
        ActiveWorldName = name;
    }

    private async Task SelectWorldAsync(WorldInfo world)
    {
        if (world.Name == ActiveWorldName || Busy) return;
        Busy = true;
        try
        {
            if (Bedrock.ServerRunning)
            {
                BusyMessage = $"Stopping server to switch to {world.Name}...";
                StateHasChanged();
                if (!await Bedrock.StopAsync("Changing active world", TimeSpan.FromSeconds(5)))
                    throw new InvalidOperationException("Server could not be stopped.");
                SetLevelName(world.Name);
                BusyMessage = $"Starting server with {world.Name}...";
                StateHasChanged();
                Bedrock.StartServer();
                Snackbar.Add($"Switched to {world.Name}; server restarting.", Severity.Success);
            }
            else if (Bedrock.CommandRunning)
            {
                Snackbar.Add("Wait until the current maintenance task finishes before switching worlds.", Severity.Warning);
            }
            else
            {
                SetLevelName(world.Name);
                Snackbar.Add($"Active world set to {world.Name}. Takes effect on next start.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"World switch failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            Busy = false;
            BusyMessage = string.Empty;
            Refresh();
        }
    }

    private async Task ImportWorld(IBrowserFile? file)
    {
        if (file is null) return;
        Busy = true;
        BusyMessage = $"Importing {file.Name}...";
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 1024L * 1024 * 1024);
            using var copy = new MemoryStream();
            await stream.CopyToAsync(copy);
            copy.Seek(0, SeekOrigin.Begin);
            var imported = await Bedrock.ImportWorldAsync(copy, file.Name);
            Snackbar.Add($"Imported world: {string.Join(", ", imported)}", Severity.Success);
            Refresh();
            SelectedWorld = Worlds.FirstOrDefault(w => imported.Contains(w.Name)) ?? SelectedWorld;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"World import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            Busy = false;
            StateHasChanged();
        }
    }

    private async Task NewWorldKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateWorldAsync();
    }

    private async Task CreateWorldAsync()
    {
        string? name = (SearchText ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name) || name is "." or ".." || name.IndexOfAny(['/', '\\']) >= 0 ||
name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
        {
            name = await GetNameByDialog();
            if (name is null) return;

            if (string.IsNullOrWhiteSpace(name) || name is "." or ".." || name.IndexOfAny(['/', '\\']) >= 0 ||
name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
            {
                Snackbar.Add("Enter a valid world (folder) name.", Severity.Error);
                return;
            }
        }
        var dir = Path.Combine(Bedrock.GetWorldsPath(), name);
        if (Directory.Exists(dir) || File.Exists(dir))
        {
            Snackbar.Add($"A world named '{name}' already exists.", Severity.Error);
            return;
        }
        Busy = true;
        try
        {
            // Create the folder and select it, so the BDS software generates
            // the world files there on next start.
            Directory.CreateDirectory(dir);
            NewWorldName = "";
            Snackbar.Add($"Created world folder '{name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Create failed: {ex.Message}", Severity.Error);
            Busy = false;
            Refresh();
            return;
        }
        Busy = false;
        Refresh();
        SelectedWorld = Worlds.FirstOrDefault(w => w.Name == name) ?? SelectedWorld;
        var world = SelectedWorld is not null && SelectedWorld.Name == name ? SelectedWorld : Bedrock.GetWorld(name);
        if (world is not null)
            await SelectWorldAsync(world);

        async Task<string?> GetNameByDialog()
        {
            var parameters = new DialogParameters
            {
                { nameof(NewItemDialog.Value), Server.Settings.Name + "World" }
            };

            var options = new DialogOptions
            {
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<NewItemDialog>("New World", parameters, options);
            var result = await dialog.Result;

            if (result?.Canceled == false && result.Data is string newValue)
                return newValue.Trim();
            return null;
        }
    }

}
