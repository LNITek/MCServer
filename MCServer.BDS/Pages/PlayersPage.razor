@using MCServer.BDS.Services
@using MCServer.Plugins

<PageTitle>@(Server?.Settings.Name ?? "MCServer") - Player Settings</PageTitle>

<style>
    .list-page-layout {
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 16px;
    }

    .list-page {
        width: 360px;
        flex-shrink: 0;
        height: 100%;
    }

    .list-page-detail {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        overflow: auto;
    }

    .list-page-overlay {
        position: absolute;
        inset: 0;
        background: var(--mud-palette-background);
        z-index: 10;
        overflow: auto;
    }

    @@media (max-width: 959.98px) {
        .list-page {
            width: 100%;
        }
    }
</style>

<div style="position: relative; height: 100%;">
    <div class="list-page-layout">
        <MudStack Spacing="3" Class="list-page" Style="height: 100%;">
            <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable
                          Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search"
                          OnAdornmentClick="@Search" TextChanged="@(s => Search(s))">
            </MudTextField>

            <MudList T="Player" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="SelectedPlayer"
                     Style="overflow:auto; height:100%">
            @foreach (var player in Players)
            {
                <MudListItem Value="@player">
                    <ChildContent>
                        <MudStack Spacing="1" Row AlignItems="AlignItems.Center">
                            <MudChip Color="@player.PlayerLimitColour" Text="@player.Permissions.ToString()"/>

                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">@player.Name</MudText>
                                <MudText Typo="Typo.body2">@player.Xuid</MudText>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudListItem>
            }
            </MudList>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Rounded.Add"
                       OnClick="AddPlayer_Click">Add Player</MudButton>
        </MudStack>

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudDivider Vertical />
        </MudHidden>

        <div class="list-page-detail">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <PlayersDisplayPage Server="@Bedrock" @bind-Player="SelectedPlayer"
                                     OnStateHasChanged="StateHasChanged" />
            </MudHidden>
        </div>
    </div>

    @if (SelectedPlayer != default)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="list-page-overlay">
                <PlayersDisplayPage Server="@Bedrock" @bind-Player="SelectedPlayer" ShowBack
                                     OnStateHasChanged="StateHasChanged" />
            </div>
        </MudHidden>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IGameServer Server { get; set; } = null!;

    private BedrockServer Bedrock => (BedrockServer)Server;

    private IGameServer? _loadedServer;

    public ExList<Player> Players = new([]);
    public string SearchText { get; set; } = string.Empty;
    public Player? SelectedPlayer = default;

    /// <summary>Reloads when the <c>Server</c> parameter changes (same page reused for another server).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedServer, Server)) return;
        _loadedServer = Server;
        Players = new(Bedrock.PlayerList);
        Players.SetSort((a, b) => a.Xuid.CompareTo(b.Xuid));
        //SelectedPlayer = Bedrock.PlayerList.FirstOrDefault();
        SelectedPlayer = default;

        Players.SetFilter(filter =>
            {
                if (string.IsNullOrWhiteSpace(SearchText)) return true;
                return filter.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    filter.Xuid.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
            });
    }

    private void AddPlayer_Click()
    {
        Bedrock.PlayerList.Add(new());
        SelectedPlayer = Bedrock.PlayerList.LastOrDefault();
        StateHasChanged();
    }

    private void Search(string value)
    {
        SearchText = value;
        Search();
    }

    private void Search()
    {
        Players.RefreshFilter();
        StateHasChanged();
    }
}
