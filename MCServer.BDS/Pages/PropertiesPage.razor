@using MCServer.BDS.Services
@using MCServer.Plugins

<PageTitle>@(Server?.Settings.Name ?? "MCServer") - Properties</PageTitle>

<style>
    .list-page-layout {
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 16px;
    }

    .list-page {
        width: 360px;
        flex-shrink: 0;
        height: 100%;
    }

    .list-page-detail {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        overflow: auto;
    }

    .list-page-overlay {
        position: absolute;
        inset: 0;
        background: var(--mud-palette-background);
        z-index: 10;
        overflow: auto;
    }

    @@media (max-width: 959.98px) {
        .list-page {
            width: 100%;
        }
    }
</style>

<div style="position: relative; height: 100%;">
    <div class="list-page-layout">
        <MudStack Spacing="3" Class="list-page" Style="height: 100%;">
            <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable
                          Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search"
                          OnAdornmentClick="@Search" TextChanged="@(s => Search(s))">
            </MudTextField>

            <MudList T="Property" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="SelectedProperty"
                     Style="overflow:auto; height:100%">
                @foreach (var property in Properties)
                {
                    <MudListItem Value="@property">
                        <ChildContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@property.Name</MudText>
                                <MudText Typo="Typo.body2" Class="ml-4">@property.ShortDesc</MudText>
                            </MudStack>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Rounded.Add"
                       OnClick="AddProperty_Click">Add Property</MudButton>
        </MudStack>

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudDivider Vertical />
        </MudHidden>

        <div class="list-page-detail">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <PropertiesDisplayPage Server="@Bedrock" @bind-Property="SelectedProperty"
                                       @bind-PropertiesList="PropertiesList" OnStateHasChanged="StateHasChanged" />
            </MudHidden>
        </div>
    </div>

    @if (SelectedProperty != default)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="list-page-overlay">
                <PropertiesDisplayPage Server="@Bedrock" @bind-Property="SelectedProperty" ShowBack
                                       OnStateHasChanged="StateHasChanged" />
            </div>
        </MudHidden>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IGameServer Server { get; set; } = null!;

    private BedrockServer Bedrock => (BedrockServer)Server;

    private IGameServer? _loadedServer;

    public ObservableCollection<Property> PropertiesList = [];
    public ExList<Property> Properties;
    public string SearchText { get; set; } = string.Empty;
    public Property? SelectedProperty = default;

    public PropertiesPage()
    {
        Properties = new(PropertiesList);
        Properties.SetSort((a, b) =>
        {
            var sort = a.Order.CompareTo(b.Order);
            if (sort == 0)
                sort = a.Name.CompareTo(b.Name);
            return sort;
        });
        Properties.SetFilter(filter =>
        {
            if (string.IsNullOrWhiteSpace(SearchText)) return true;
            return filter.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
        });
    }

    /// <summary>Reloads when the <c>Server</c> parameter changes (same page reused for another server).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedServer, Server)) return;
        _loadedServer = Server;
        PropertiesList.Clear();
        PropertiesList.AddRange(Bedrock.GetProperties());
        SelectedProperty = default;
        //SelectedProperty = PropertiesList.FirstOrDefault();
    }

    private void AddProperty_Click()
    {
        PropertiesList.Add(new() { Order = (PropertiesList.LastOrDefault()?.Order ?? -1) + 1 });
        SelectedProperty = PropertiesList.LastOrDefault();
        StateHasChanged();
    }

    private void Search(string value)
    {
        SearchText = value;
        Search();
    }

    private void Search()
    {
        Properties.RefreshFilter();
        StateHasChanged();
    }
}
