@using MCServer.BDS.Services
@using MCServer.Plugins

<PageTitle>@(Server?.Settings.Name ?? "MCServer") - Packet Rate Limits</PageTitle>

<style>
    .list-page-layout {
        height: 100%;
        display: flex;
        flex-direction: row;
        gap: 16px;
    }

    .list-page {
        width: 360px;
        flex-shrink: 0;
        height: 100%;
    }

    .list-page-detail {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        overflow: auto;
    }

    .list-page-overlay {
        position: absolute;
        inset: 0;
        background: var(--mud-palette-background);
        z-index: 10;
        overflow: auto;
    }

    @@media (max-width: 959.98px) {
        .list-page {
            width: 100%;
        }
    }
</style>

<div style="position: relative; height: 100%;">
    <div class="list-page-layout">
        <MudStack Spacing="3" Class="list-page" Style="height: 100%;">
            <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable
                          Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search"
                          OnAdornmentClick="@Search" TextChanged="@(s => Search(s))">
            </MudTextField>

            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Rounded.SelectAll" OnClick="SelectDefault_Click">Select Default</MudButton>

            <MudList T="PacketConfig.Limit" SelectionMode="SelectionMode.SingleSelection"
                     @bind-SelectedValue="SelectedLimit" Style="overflow:auto; height:100%">
                @foreach (var limit in Limits)
                {
                    <MudListItem Value="@limit">
                        <ChildContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@($"[{limit.PacketIds}]")</MudText>
                                <MudText Typo="Typo.body2" Class="ml-4">@limit.algorithm.name</MudText>
                            </MudStack>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Rounded.Add"
                       OnClick="AddLimit_Click">Add Player</MudButton>
        </MudStack>

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudDivider Vertical />
        </MudHidden>

        <div class="list-page-detail">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <PacketsDisplayPage Server="@Bedrock" @bind-Limit="SelectedLimit" Config="Config"
                                    OnStateHasChanged="StateHasChanged" />
            </MudHidden>
        </div>
    </div>

    @if (SelectedLimit != default)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="list-page-overlay">
                <PacketsDisplayPage Server="@Bedrock" @bind-Limit="SelectedLimit" Config="Config" ShowBack
                                    OnStateHasChanged="StateHasChanged" />
            </div>
        </MudHidden>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IGameServer Server { get; set; } = null!;

    private BedrockServer Bedrock => (BedrockServer)Server;

    private IGameServer? _loadedServer;

    public PacketConfig Config = new();
    public ExList<PacketConfig.Limit> Limits = new([]);
    public string SearchText { get; set; } = string.Empty;
    public PacketConfig.Limit? SelectedLimit = default;

    /// <summary>Reloads when the <c>Server</c> parameter changes (same page reused for another server).</summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedServer, Server)) return;
        _loadedServer = Server;
        Config = Bedrock.GetPacketConfig();
        Limits = new(Config.limitGroups);
        //SelectedLimit = Config.DefaultLimit;
        SelectedLimit = default;

        Limits.SetFilter(filter =>
        {
            if (string.IsNullOrWhiteSpace(SearchText) || !uint.TryParse(SearchText, out var SearchID)) return true;
            return filter.minecraftPacketIds.Contains(SearchID);
        });
    }

    private void SelectDefault_Click()
    {
        SelectedLimit = Config.DefaultLimit;
    }

    private void AddLimit_Click()
    {
        Config.limitGroups.Add(new());
        SelectedLimit = Config.limitGroups.LastOrDefault();
        StateHasChanged();
    }

    private void Search(string value)
    {
        SearchText = value;
        Search();
    }

    private void Search()
    {
        Limits.RefreshFilter();
        StateHasChanged();
    }
}
