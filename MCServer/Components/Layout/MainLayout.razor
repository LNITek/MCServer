@using System.ComponentModel
@using System.Reflection.Metadata.Ecma335
@inherits LayoutComponentBase
@implements IDisposable
@inject ILocalStorageService Storage;
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject GameServers Servers
@inject PageHeaderService HeaderService

<MudThemeProvider @ref="_mudThemeProvider" Theme="Theme.MasterTheme" @bind-IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    .mud-badge.mud-badge-bottom.right {
        inset: auto;
    }
    .mud-navmenu {
        height: 100%;
        margin: 0;
        position: relative;
        list-style: none;
        overscroll-behavior-y: contain;
    }
