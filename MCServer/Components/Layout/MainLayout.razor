@using System.Text.Json
@using System.Text.Json.Serialization.Metadata
@using Microsoft.Extensions.Options
@inherits LayoutComponentBase
@inject ILocalStorageService Storage;
@inject ISnackbar Snackbar
@inject IOptions<AppSettings> Config;
@inject NavigationManager Nav
@inject GameServers Servers

<MudThemeProvider @ref="_mudThemeProvider" Theme="Theme.MasterTheme" @bind-IsDarkMode="IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer"/>
        <MudText Color="Color.Primary" Typo="Typo.h6">@PageHeader</MudText>
        <MudSpacer />
        <MudIconButton Icon="@GetToggleTheme()" Color="Color.Inherit" OnClick="ToggleDarkMode" />@* Style="position:fixed; top:12px; right:12px; z-index:9999;" *@
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudDrawerHeader>
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                <MudImage Src="favicon.png" Alt="Icon" Width="32" Height="32" ObjectFit="ObjectFit.Contain" />
                <MudText Typo="Typo.h6">MCServer</MudText>
            </MudStack>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Rounded.Dashboard">Dashboard</MudNavLink>

            <MudNavGroup Icon="@Icons.Rounded.Dns">
                <TitleContent>
                    <a href="/servers">Servers</a>
                    @* <MudButton Variant="Variant.Text" Style="padding: 0px 2px; text-transform:none; justify-content: start; width:100%;" Href="/servers">Servers</MudButton> *@
                </TitleContent>
                <ChildContent>
                    @foreach (var server in Servers)
                    {
                        <MudNavGroup Icon="@Icons.Rounded.Monitor" Title="Default">
                            <TitleContent>
                                <MudBadge Origin="Origin.BottomLeft" Color="@(RunningStatus(server))" Overlap>
                                    <a href="@($"/servers/{server.Settings.ID}")">@server.Settings.Name</a>
                                </MudBadge>
                                @* <MudButton Variant="Variant.Text" Style="padding: 0px 2px; text-transform:none; justify-content: start; width:100%;" Href="/overview">Default</MudButton> *@
                            </TitleContent>
                            <ChildContent>
                                <MudNavLink Icon="@Icons.Rounded.Terminal" Href="@($"/servers/{server.Settings.ID}/console")">Console</MudNavLink>
                                <MudNavLink Icon="@Icons.Rounded.HomeRepairService" Href="@($"/servers/{server.Settings.ID}/props")">Properties</MudNavLink>
                                <MudNavLink Icon="@Icons.Rounded.AdminPanelSettings" Href="@($"/servers/{server.Settings.ID}/player-settings")">Player Settings</MudNavLink>
                                <MudNavLink Icon="@Icons.Rounded.Backpack" Href="@($"/servers/{server.Settings.ID}/packets")">Packet Configs</MudNavLink>
                                <MudNavLink Icon="@Icons.Rounded.Timer" Href="@($"/servers/{server.Settings.ID}/schedules")">Schedules</MudNavLink>
                            </ChildContent>
                        </MudNavGroup>
                    }
                </ChildContent>
            </MudNavGroup>

            <MudSpacer />
            <MudDivider Class="my-2" />

            <MudNavLink Icon="@Icons.Rounded.StickyNote2" Href="/docs/host/notes">How To</MudNavLink>
            <MudNavLink Icon="@Icons.Rounded.EventNote" Href="/docs/host/releases">Release Notes</MudNavLink>
            <MudNavLink Icon="@Icons.Rounded.Settings" Href="/settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Style="height:100%; display:flex; flex-direction:column;">
        <div style="height:100%; display:flex; flex-direction:column; padding:18px;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _open = true;

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private bool IsDarkMode { get; set; } = true;
    private MudThemeProvider _mudThemeProvider = default!;

    private void ToggleDarkMode()
    {
        IsDarkMode = !IsDarkMode;
        Storage.SetItemAsync(nameof(IsDarkMode), IsDarkMode);
    }

    private string GetToggleTheme() => IsDarkMode ? Icons.Rounded.LightMode : Icons.Rounded.DarkMode;

    private string PageHeader
    {
        get
        {
            var URL = Nav.Uri[(Nav.Uri.LastIndexOf('/') + 1)..];
            return URL switch
            {
                "" => "Dashboard",
                "overview" => "Overview",
                "console" => "Console",
                "props" => "Properties",
                "player-settings" => "Player Settings",
                "packets" => "Packet Rate Limit Config",
                "schedules" => "Schedule",
                "notes" => "How To",
                "releases" => "Release Notes",
                "settings" => "Settings",
                _ when Nav.Uri.Contains("servers") => Servers.FindByID(URL)?.Settings.Name ?? "MCServer",
                _ => "MCServer"
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Program.Snackbar = Snackbar;
        Program.Settings = Config.Value;
        
        if (firstRender)
        {
            IsDarkMode = (await Storage.GetItemAsync<bool?>(nameof(IsDarkMode))) ?? await _mudThemeProvider.GetSystemDarkModeAsync();
            Servers.Register(Program.Settings.ServerSettings);
            StateHasChanged();
        }
    }

    private Color RunningStatus(IGameServer server) => server.ServerRunning ? Color.Success : Color.Error;
}
