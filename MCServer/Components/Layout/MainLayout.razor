<div id="blazor-error-ui" data-nosnippet style="z-index: 10000; color: var(--mud-palette-error-text); background-color: var(--mud-palette-error);">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _open = true;

    protected override void OnInitialized()
    {
        foreach (var server in Servers)
            server.Settings.PropertyChanged += OnServerSettingsChanged;
        HeaderService.Changed += OnHeaderChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnServerSettingsChanged(object? sender, PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnHeaderChanged() =>
        InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        foreach (var server in Servers)
            server.Settings.PropertyChanged -= OnServerSettingsChanged;
        HeaderService.Changed -= OnHeaderChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private bool IsDarkMode { get; set; } = true;
    private MudThemeProvider _mudThemeProvider = default!;

    private void ToggleDarkMode()
    {
        IsDarkMode = !IsDarkMode;
        Storage.SetItemAsync(nameof(IsDarkMode), IsDarkMode);
    }

    private string GetToggleTheme() => IsDarkMode ? Icons.Rounded.LightMode : Icons.Rounded.DarkMode;

    private string DefaultPageHeader
    {
        get
        {
            var URL = Nav.Uri[(Nav.Uri.LastIndexOf('/') + 1)..];
            return URL switch
            {
                "" => "Dashboard",
                "overview" => "Overview",
                "console" => "Console",
                "files" => "Files",
                "schedules" => "Schedule",
                "props" => "Properties",
                "player-settings" => "Player Settings",
                //"packets" => "Packet Rate Limit Config",
                "notes" => "How To",
                "releases" => "Release Notes",
                "plugins" => "Plugins",
                "settings" => "Settings",
                _ when Nav.Uri.Contains("servers") => Servers.FindByID(URL)?.Settings.Name ?? "MCServer",
                _ => "MCServer"
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Program.Snackbar = Snackbar;
        
        if (firstRender)
        {
            IsDarkMode = (await Storage.GetItemAsync<bool?>(nameof(IsDarkMode))) ?? await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
