        <MudDivider Class="my-2" />

        <MudNavLink Icon="@Icons.Rounded.StickyNote2" Href="/docs/host/notes">How To</MudNavLink>
        <MudNavLink Icon="@Icons.Rounded.EventNote" Href="/docs/host/releases">Release Notes</MudNavLink>
