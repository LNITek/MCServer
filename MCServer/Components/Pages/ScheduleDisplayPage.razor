@implements IDisposable
@using System.ComponentModel

<MudGrid Spacing="4">
    @if (Schedule is null)
    {
        <MudItem xs="12">
            <MudAlert Variant="Variant.Text" Severity="Severity.Info">Select a schedule or create a new one.</MudAlert>
        </MudItem>
        return;
    }

    <MudItem xs="12">
        <MudStack Spacing="1" Row>
            @if (ShowBack)
            {
                <MudIconButton Variant="Variant.Text" Color="Color.Inherit" Icon="@Icons.Filled.ArrowBack"
                               OnClick="ShowList" />
            }

            <MudSpacer />

            <MudTooltip Text="Enabled">
                <MudToggleIconButton Icon="@(Schedule.Enabled ? Icons.Filled.CheckCircle : Icons.Filled.RadioButtonUnchecked)"
                                     @bind-Toggled="Schedule.Enabled" @bind-Toggled:after="Save"/>
            </MudTooltip>
            <MudTooltip Text="Save">
                <MudIconButton Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Rounded.Save" OnClick="Save" />
            </MudTooltip>
            <MudTooltip Text="Delete">
                <MudIconButton Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Rounded.Delete"
                               OnClick="DeleteSchedule_Click" />
            </MudTooltip>
        </MudStack>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudSelect Variant="Variant.Outlined" T="TriggerKind" Label="Trigger"
                   Value="@Schedule.Trigger" ValueChanged="TriggerChanged" FullWidth>
            @foreach (var kind in Enum.GetValues<TriggerKind>())
            {
                <MudSelectItem Value="kind">@kind.ToString()</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudTextField Variant="Variant.Outlined" T="string" Label="Name" @bind-Value="Schedule.Name" />
    </MudItem>
    <MudItem xs="12">
        <MudTextField Variant="Variant.Outlined" T="string" Lines="3" Sizing="InputSizing.Auto"
                      Label="Description" @bind-Value="Schedule.Description" />
    </MudItem>
    <MudItem xs="12">
        <MudTextField Variant="Variant.Outlined" T="string" Label="Command" @bind-Value="Schedule.Command" />
    </MudItem>

    @if (Schedule.Trigger is TriggerKind.Once)
    {
        <MudItem xs="12" md="6">
            <MudDatePicker T="DateTime?" Label="Date" Variant="Variant.Outlined" Date="@Schedule.OneShotDue"
                           DateChanged="OnOneShotDateChanged" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTimePicker T="TimeSpan?" Label="Time" Variant="Variant.Outlined" Time="@Schedule.OneShotDue.TimeOfDay"
                           TimeChanged="OnOneShotTimeChanged" />
        </MudItem>
    }

    @if (Schedule.Trigger is TriggerKind.Cron)
    {
        <MudItem xs="12" md="6">
            <MudTextField Variant="Variant.Outlined" T="string" Label="Cron Expression"
                          Value="@Schedule.Cron" ValueChanged="OnCronChanged"
                          Error="@(_cronError is not null)" ErrorText="@_cronError"
                          HelperText="e.g. 0 12 * * * (daily at noon)" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker T="DateTime?" Label="From (optional)" Variant="Variant.Outlined"
                           @bind-Value="Schedule.StartDate" @bind-Value:after="Save" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker T="DateTime?" Label="Until (optional)" Variant="Variant.Outlined"
                           @bind-Value="Schedule.EndDate" @bind-Value:after="Save" />
        </MudItem>
    }

    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Color="@Schedule.StateBrush"
                             Text="@Schedule.Status.ToString()" />
                    <MudText Typo="Typo.body1" Style="font-weight:600;">@Schedule.StatusLabel</MudText>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(Schedule.StatusReason))
                {
                    <MudText Typo="Typo.body2" Color="@Schedule.StateBrush">@Schedule.StatusReason</MudText>
                }
                <MudText Typo="Typo.body2">
                    Next run: @(Schedule.NextRun is null ? "—/none" : Schedule.NextRunFormatted)
                </MudText>
                <MudText Typo="Typo.body2">@Schedule.LastRunFormatted</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public Schedule? Schedule
    {
        get => _schedule;
        set
        {
            // The parent re-render re-assigns this parameter every pass (same
            // instance); re-raising ScheduleChanged then would re-render the
            // parent, which re-assigns the parameter again — an endless in-circuit
            // render loop that freezes every further interaction on the page.
            if (ReferenceEquals(_schedule, value)) return;
            if (_schedule is not null) _schedule.PropertyChanged -= OnScheduleChanged;
            _schedule = value;
            _cronError = null;
            if (_schedule is not null) _schedule.PropertyChanged += OnScheduleChanged;
            ScheduleChanged.InvokeAsync(value);
        }
    }
    private Schedule? _schedule { get; set; } = default;
    private string? _cronError;
    [Parameter]
    public EventCallback<Schedule?> ScheduleChanged { get; set; }

    [Parameter, EditorRequired]
    public IGameServer Server { get; set; } = null!;
    [Parameter]
    public bool ShowBack { get; set; } = false;

    [Parameter]
    public EventCallback OnStateHasChanged { get; set; }

    private void UpdateState()
    {
        StateHasChanged();
        OnStateHasChanged.InvokeAsync();
    }

    /// <summary>Schedule runtime state (status/next run/last run) lives on a
    /// background thread; re-render when it changes so the panel stays live.</summary>
    private void OnScheduleChanged(object? sender, PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void ShowList()
    {
        Schedule = null;
    }

    public void Dispose()
    {
        if (_schedule is not null) _schedule.PropertyChanged -= OnScheduleChanged;
        Save();
    }

    private void Save()
    {
        if (Server == null) return;
        Server.FlushSchedules();
        UpdateState();
    }

    private void DeleteSchedule_Click()
    {
        if (Server == null || Schedule == null) return;
        var removed = Schedule;
        Schedule = null;
        Server.ServerSchedules.Remove(removed);
        Save();
    }

    private void TriggerChanged(TriggerKind kind)
    {
        if (Schedule is null) return;
        Schedule.Trigger = kind;
        UpdateState();
    }

    private void OnOneShotDateChanged(DateTime? date)
    {
        if (Schedule is null || date is not { } picked) return;
        Schedule.OneShotDue = picked.Date + Schedule.OneShotDue.TimeOfDay;
        Save();
    }

    private void OnOneShotTimeChanged(TimeSpan? time)
    {
        if (Schedule is null || time is not { } picked) return;
        Schedule.OneShotDue = Schedule.OneShotDue.Date + picked;
        Save();
    }

    /// <summary>Accepts any text the user typed (the engine will flag bad
    /// expressions with an Invalid status), but surfaces a parse error right
    /// in the field so mistakes are visible immediately.</summary>
    private void OnCronChanged(string text)
    {
        if (Schedule is null) return;
        Schedule.Cron = text;
        _cronError = Cronos.CronExpression.TryParse(text, out _) ? null : "Invalid cron expression (e.g. 0 12 * * *).";
        Save();
    }
}
