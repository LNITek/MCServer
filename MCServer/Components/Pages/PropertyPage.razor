@page "/props"
@implements IDisposable
@inject MCBedrockServer Server
@using System.Collections.ObjectModel

<PageTitle>MCServer - Properties</PageTitle>

<style>
    .mud-input-control
    {
        border: 0;
        margin: 0;
        padding: 0;
        display: flex;
        flex: 0 1 auto;
        max-width: 100%;
        position: relative;
        flex-direction: column;
        vertical-align: top;
    }
</style>

<div style="height:100%; display:flex; flex-direction:row;">
    <MudStack Spacing="3" Style="min-width:25%; max-width:30%; width: 100%;">
        <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable Variant="Variant.Outlined"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search" OnAdornmentClick="@Search"
                      TextChanged="@(s => Search(s))">
        </MudTextField>

        <MudList T="Property" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="SelectedProperty" Style="overflow:auto; height:100%">
            @foreach(var property in Properties)
            {
                <MudListItem Value="@property">
                    <ChildContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">@property.Name</MudText>
                            <MudText Typo="Typo.body2" Class="ml-4">@property.ShortDesc</MudText>
                        </MudStack>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Rounded.Add" OnClick="AddProperty_Click">Add Property</MudButton>
    </MudStack>

    <MudDivider Vertical Class="mx-4"/>

    <MudStack Style="flex-grow:1; overflow:auto;">
        <MudAlert Variant="Variant.Text" Severity="Severity.Warning">These changes is only in an effect after a restart!</MudAlert>
        
        @if (SelectedProperty is not null)
        {
            <MudStack Spacing="1" Row>
                <MudSpacer/>
                <MudIconButton Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Rounded.Save" OnClick="Save"/>
                
                @if (SelectedProperty.Mode == PropertyEditMode.Overwrite)
                {
                    <MudIconButton Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Rounded.RestartAlt" OnClick="ResetProperty_Click"/>
                }
                else if (SelectedProperty.Mode == PropertyEditMode.Custom)
                {
                    <MudIconButton Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Rounded.Delete" OnClick="DeleteProperty_Click"/>
                }
            </MudStack>
            
        @if (SelectedProperty.Mode == PropertyEditMode.Custom)
            {
                <MudTextField Variant="Variant.Outlined" T="string" Label="Name" @bind-Value="SelectedProperty.Value"></MudTextField>
                <MudTextField Variant="Variant.Outlined" T="string" Label="Value" @bind-Value="SelectedProperty.Value"></MudTextField>
                <MudTextField Variant="Variant.Outlined" T="string" Placeholder="Description" @bind-Value="SelectedProperty.Value" MaxLines="25">
                </MudTextField>
            }
            else
            { 
                <MudText Typo="Typo.h6">@SelectedProperty.Name</MudText>
                <MudTextField Variant="Variant.Outlined" T="string" Placeholder="Property Value" @bind-Value="SelectedProperty.Value"></MudTextField>
                <MudText Typo="Typo.h6">Description</MudText>
                <MudText Typo="Typo.body1" Style="white-space:pre-line;flex-grow:1; overflow:auto;">@SelectedProperty.Desc</MudText>
            }
        }
        else
        {
            <MudAlert Variant="Variant.Text" Severity="Severity.Info">Select a property or create a new one.</MudAlert>
        }
    </MudStack>
</div>

@code {
    public ObservableCollection<Property> PropertiesList = [];
    public ExList<Property> Properties;
    public string SearchText { get; set; } = string.Empty;
    public Property? SelectedProperty = default;

    public PropertyPage()
    {
        Properties = new(PropertiesList);
        Properties.SetSort((a, b) => a.Order.CompareTo(b.Order));
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        PropertiesList.AddRange(Server.GetProperties());
        SelectedProperty = PropertiesList.FirstOrDefault();
        Properties.SetFilter(filter =>
        {
            if (string.IsNullOrWhiteSpace(SearchText)) return true;
            return filter.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
        });
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }
    
    public void Dispose()
    {
        Save();
    }
    
    private void Save()
    {
        Server.SetProperties(PropertiesList);
    }
    
    private void AddProperty_Click()
    {
        PropertiesList.Add(new() { Order = (PropertiesList.LastOrDefault()?.Order ?? -1) + 1 });
        SelectedProperty = PropertiesList.LastOrDefault();
        StateHasChanged();
    }

    private void DeleteProperty_Click()
    {
        if(SelectedProperty?.Mode != PropertyEditMode.Custom) return;
        PropertiesList.Remove(SelectedProperty);
        SelectedProperty = null;
        Save();
        StateHasChanged();
    }

    private void ResetProperty_Click()
    {
        if(SelectedProperty?.Mode != PropertyEditMode.Overwrite) return;
        SelectedProperty.Mode = PropertyEditMode.None;
        Save();
        StateHasChanged();
    }

    private void Search(string value)
    {
        SearchText = value;
        Search();
    }

    private void Search() 
    {
        Properties.RefreshFilter();
        StateHasChanged();
    }
}