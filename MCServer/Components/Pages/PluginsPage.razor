@page "/plugins"
@using MCServer.Components.Dialogs
@using MCServer.Plugins
@inject PluginService Plugins
@inject GameServers GameServers
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>MCServer - Plugins</PageTitle>

<MudGrid Spacing="4">
    
    @if (Plugins.RestartRequired)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Warning">A plugin was installed or uninstalled. Restart the app to apply the
                change.
            </MudAlert>
        </MudItem>
    }
    
    <MudItem xs="9">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h6">Server Plugins</MudText>
            
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Upload a plugin <c>.dll</c> or a <c>.zip</c> package. 
                Files are stored in <c>@Plugins.PluginsPath</c>.
            </MudText>
        </MudStack>
    </MudItem>

    <MudItem xs="3">
        <div style="display: flex; justify-content: flex-end;">
            <MudTooltip Text="Install new plugin">
                <MudFileUpload T="IBrowserFile" FilesChanged="InstallPlugin" Accept=".dll,.zip" MaximumFileCount="1"
                                 @ref="_pluginUpload">
                    <CustomContent>
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Rounded.Add"
                                        OnClick="@context.OpenFilePickerAsync" />
                    </CustomContent>
                    @* Empty template: suppresses the selected-file chip/token. *@
                    <SelectedTemplate />
                </MudFileUpload>
            </MudTooltip>
        </div>
    </MudItem>

    <MudItem xs="12">
        <MudTable Items="@Plugins.ServerPlugins" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Server Type</MudTh>
                <MudTh>Author</MudTh>
                <MudTh>Version</MudTh>
                <MudTh>Pages</MudTh>
                <MudTh Style="width: 110px;" />
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    @context.DisplayName
                    @if (Plugins.IsBuiltIn(context))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Built-in
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Server Type">
                    <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                        <MudChip T="string" Size="Size.Small">@context.ServerType</MudChip>
                        @foreach (var alias in context.Aliases)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@alias</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Author">@context.Author</MudTd>
                <MudTd DataLabel="Version">@context.Version</MudTd>
                <MudTd DataLabel="Pages" Class="" Style="text-wrap: balance;">
                    @if (context is IServerPagesProvider pages)
                    {
                        @string.Join(", ", pages.GetPages().Select(p => p.Title))
                    }
                </MudTd>
                <MudTd Style="text-align:right; min-width: 110px; flex-grow: 1;">
                    <MudStack Row Justify="Justify.FlexEnd">
                        <MudTooltip
                            Text="@(Plugins.IsBuiltIn(context) ? "Built-in plugins cannot be uninstalled" : "Uninstall plugin")">
                            <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Rounded.Delete"
                                           OnClick="@(() => UninstallPlugin(context))" Disabled="@Plugins.IsBuiltIn(context)" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private MudFileUpload<IBrowserFile>? _pluginUpload;

    private async Task InstallPlugin(IBrowserFile? file)
    {
        if (file is null) return;

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            var message = await Plugins.InstallAsync(stream, file.Name);
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Install failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            // Clear the picker selection so no chip lingers and the same file can be picked again.
            try { if (_pluginUpload is not null) await _pluginUpload.ClearAsync(); } catch { }
        }

        StateHasChanged();
    }
    private async Task UninstallPlugin(IGameServerPlugin plugin)
    {
        if (Plugins.IsBuiltIn(plugin))
        {
            Snackbar.Add($"Built-in plugin '{plugin.DisplayName}' cannot be uninstalled.", Severity.Warning);
            return;
        }

        if (IsPluginInUse(plugin, out var userName))
        {
            Snackbar.Add($"Plugin '{plugin.DisplayName}' is still used by server '{userName}'. Delete that server first.",
Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(ConfirmDialog.Message), $"Uninstall plugin '{plugin.DisplayName}' ({plugin.ServerType})? Its files will be deleted. Restart is required to unload it." },
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Uninstall plugin", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            var message = await Plugins.UninstallAsync(plugin.ServerType, IsTypeInUse);
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Uninstall failed: {ex.Message}", Severity.Error);
        }

        StateHasChanged();
    }

    private bool IsTypeInUse(string serverType) =>
        GameServers.Any(s => s.Settings.Type.Equals(serverType, StringComparison.OrdinalIgnoreCase));

    private bool IsPluginInUse(IGameServerPlugin plugin, out string serverName)
    {
        var server = GameServers.FirstOrDefault(s =>
            s.Settings.Type.Equals(plugin.ServerType, StringComparison.OrdinalIgnoreCase) ||
            plugin.Aliases.Any(a => a.Equals(s.Settings.Type, StringComparison.OrdinalIgnoreCase)));
        serverName = server?.Settings.Name ?? "";
        return server is not null;
    }
}
