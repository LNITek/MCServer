@page "/docs/{serverId?}/{type?}"
@inject NavigationManager Nav
@inject GameServers GameServers

<PageTitle>MCServer - Documentation</PageTitle>

<style>
    blockquote, pre {
        background: var(--mud-palette-surface) !important;
    }

    code {
        background: var(--mud-palette-action-disabled) !important;
    }
</style>

<div style="flex-grow:1; margin:16px 0px; overflow:auto;">
    @HTMLContent
</div>

@code {
    private MarkupString HTMLContent;

    [Parameter] public string type { get; set; } = "";
    [Parameter] public string serverId { get; set; } = "host";
    public IGameServer? Server { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        Server = GameServers.FindByID(serverId);

        string html = DocsService.Docs404;
        switch (type)
        {
            case "notes" when Server is null: html = DocsService.GetReadMe(); break;
            case "releases" when Server is null: html = DocsService.GetReleaseNotes(); break;
            case "notes": html = Server.GetReadMe(); break;
            case "releases": html = Server.GetReleaseNotes(); break;
        }

        HTMLContent = new(html);
        StateHasChanged();

        return base.OnAfterRenderAsync(firstRender);
    }
}