@page "/docs/{type?}/{server?}"

@inject MCBedrockServer Server

<PageTitle>MCServer - Documentation</PageTitle>

<style>
    blockquote, pre {
        background: var(--mud-palette-surface) !important;
    }

    code {
        background: var(--mud-palette-action-disabled) !important;
    }
</style>

<div style="flex-grow:1; margin:16px 0px; overflow:auto;">
    @HTMLContent
</div>

@code {
    private MarkupString HTMLContent;

    [Parameter] public string type { get; set; } = "";
    [Parameter] public string server { get; set; } = "host";

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        var GServer = string.IsNullOrWhiteSpace(server) ? null : Server;

        string html = DocsService.Docs404;
        switch (type)
        {
            case "notes" when GServer is null: html = DocsService.GetReadMe(); break;
            case "releases" when GServer is null: html = DocsService.GetReleaseNotes(); break;
            case "notes": html = GServer.GetReadMe(); break;
            case "releases": html = GServer.GetReleaseNotes(); break;
        }

        HTMLContent = new(html);
        StateHasChanged();

        return base.OnAfterRenderAsync(firstRender);
    }
}