@page "/docs/{serverId?}/{type?}"
@inject NavigationManager Nav
@inject GameServers GameServers

<PageTitle>MCServer - Documentation@(string.IsNullOrEmpty(_title) ? "" : $" - {_title}")</PageTitle>

<style>
    blockquote, pre {
        background: var(--mud-palette-surface) !important;
    }

    code {
        background: var(--mud-palette-action-disabled) !important;
    }
</style>

@if (_server is not null && string.IsNullOrEmpty(type))
{
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">@_server.Settings.Name - Documentation</MudText>
        @foreach (var doc in _server.DocFiles)
        {
            <MudLink Href="@($"/docs/{_server.Settings.ID}/{doc.Slug}")">@doc.Title</MudLink>
        }
    </MudStack>
}
else
{
    <div style="flex-grow:1; margin:16px 0px; overflow:auto;">
        @HTMLContent
    </div>
}

@code {
    private MarkupString HTMLContent;
    private string _title = "";

    [Parameter] public string type { get; set; } = "";
    [Parameter] public string serverId { get; set; } = "host";
    private IGameServer? _server { get; set; }

    protected override void OnParametersSet()
    {
        _server = GameServers.FindByID(serverId);

        string html;
        if (_server is null)
        {
            html = type switch
            {
                "notes" => DocsService.GetReadMe(),
                "releases" => DocsService.GetReleaseNotes(),
                _ => DocsService.Docs404,
            };
            _title = type switch
            {
                "notes" => "How To",
                "releases" => "Release Notes",
                _ => "",
            };
        }
        else if (string.IsNullOrEmpty(type))
        {
            html = "";
            _title = _server.Settings.Name;
        }
        else
        {
            html = _server.GetServerDoc(type);
            _title = _server.DocFiles.FirstOrDefault(d =>
                d.Slug.Equals(type, StringComparison.OrdinalIgnoreCase))?.Title ?? "";
        }

        HTMLContent = new(html);
    }
}
