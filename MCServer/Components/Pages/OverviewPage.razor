@page "/servers/{serverId}"
@using System.Collections.ObjectModel
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject GameServers GameServers
@* @inject ProcessMetricsService MetricsService *@
@inject IJSRuntime JS

<PageTitle>MCServer - Overview</PageTitle>

<style>
    .dashboard-chart {
        min-height: 300px;
    }

    .dashboard-panel {
        min-height: 260px;
    }

    .h-100 {
        height: 100%;
    }

    .text-right {
        text-align: right;
    }
</style>

@if (Server is not null)
{
    <div style="flex-grow:1; overflow:auto; margin-right: -10px; padding-right: 10px;">
        <MudGrid Spacing="3">
            <!-- Navigation -->
            <MudItem xs="6" md="10">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudStack Row="true">
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/console")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Terminal">Console</MudButton>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/props")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.HomeRepairService">Properties</MudButton>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/player-settings")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Terminal">Player Settings</MudButton>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/packets")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Backpack">Packet Configs</MudButton>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/schedules")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Timer">Schedules</MudButton>
                    </MudStack>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <div style="justify-content: start; display: flex;">
                        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                            <MudButton Style="width: 100%;">Menus</MudButton>
                            <MudMenu Icon="@Icons.Filled.ArrowDropDown" Style="align-self: auto;">
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/console")" Icon="@Icons.Filled.Terminal">Console</MudMenuItem>
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/props")" Icon="@Icons.Filled.HomeRepairService">Properties</MudMenuItem>
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/player-settings")" Icon="@Icons.Filled.Terminal">Player Settings</MudMenuItem>
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/packets")" Icon="@Icons.Filled.Backpack">Packet Configs</MudMenuItem>
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/schedules")" Icon="@Icons.Filled.Timer">Schedules</MudMenuItem>
                            </MudMenu>
                        </MudButtonGroup>
                    </div>
                </MudHidden>
            </MudItem>
            <MudItem xs="6" md="2">
                <div style="justify-content: end; display: flex;">
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                        <MudButton Style="width: 100%;">Commands</MudButton>
                        <MudMenu Icon="@Icons.Filled.ArrowDropDown" Style="align-self: auto;">
                        </MudMenu>
                    </MudButtonGroup>
                </div>
            </MudItem>
            
            <!-- Header -->
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.h5" @ondblclick="EditServerName">@Server.Settings.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Server.Settings.Version
                            </MudText>
                        </div>

                        <div class="text-right">
                            <MudChip T="string"
                                     Color="@Server.ServerStatus.inticator"
                                     Variant="Variant.Filled">
                                @Server.ServerStatus.status
                            </MudChip>

                            <TimerLable StartedTime="@Server.StartupDate" Label="Uptime: " Class="mt-1"/>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Top metric cards -->
            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.Cpu"
                               Title="CPU"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.Cpu]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.Memory"
                               Title="Memory"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.Memory]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.DiskRead"
                               Title="Disk Read"
                               ShowProgress="false"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.DiskRead]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.DiskWrite"
                               Title="Disk Write"
                               ShowProgress="false"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.DiskWrite]" *@
            </MudItem>

            <!-- Performance graph -->
            @* <MudItem xs="12"> *@
            @*     <MudPaper Class="pa-4 dashboard-chart"> *@
            @*         <MudText Typo="Typo.h6">Server Performance</MudText> *@
            @* *@
            @*         <MudChart ChartType="ChartType.Timeseries" MatchBoundsToSize="true" *@
            @*                   ChartSeries="@MetricChart" *@
            @*                   ChartOptions="@ChartOptions" /> *@
            @*     </MudPaper> *@
            @* </MudItem> *@

            <!-- Player activity -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 dashboard-panel">
                    <MudText Typo="Typo.h6">Player Activity</MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Player count over the last 24 hours
                    </MudText>


                    <MudChart ChartType="ChartType.Timeseries" MatchBoundsToSize="true"
                              ChartSeries="@PlayerChart" ChartOptions="@ChartOptions"/>
                </MudPaper>
            </MudItem>

            <!-- Bottom status -->
            <MudItem xs="12">
                <MudPaper Class="pa-3">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Filled.Error" Color="Color.Error"/>
                                <MudText Color="Color.Error">
                                    @ErrorCount
                                </MudText>
                                <MudText Color="Color.Error">
                                    Errors
                                </MudText>
                                
                                <MudDivider Vertical="true"/>
                                
                                <MudIcon Icon="@Icons.Filled.Warning" Color="Color.Warning"/>
                                <MudText Color="Color.Warning">
                                    @WarningCount
                                </MudText>
                                <MudText Color="Color.Warning">
                                    Warnings
                                </MudText>
                                
                                <MudDivider Vertical="true"/>
                                
                                <MudIcon Icon="@Icons.Filled.Info" Color="Color.Info"/>
                                <MudText Color="Color.Info">
                                    @InfoCount
                                </MudText>
                                <MudText Color="Color.Info">
                                    Status
                                </MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <div style="flex-grow:1;">
                                <MudStack Spacing="2">
                                    @foreach (var item in StatusLines)
                                    {
                                        <MudText Color="@item.Colour">
                                            @(item.ToString())
                                        </MudText>
                                    }
                                </MudStack>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public string serverId { get; set; } = "";
    public MCBedrockServer Server { get; set; }

    public Timer ChartTimer;

    public Action<object?> UpdateCharts = (sender) =>
    {
        if (sender is not OverviewPage This) return;
        PushValue(This.PlayerCount_History, This.Server.PlayerList.Count);
        This.InvokeAsync(This.StateHasChanged);
    };

    private List<ChartSeries<int>> PlayerChart = new();
    public int[] PlayerCount_History = new int[24];

    ObservableCollection<ConsoleLine> StatusList = [];
    public ExList<ConsoleLine> StatusLines { get; set; }
    public int ErrorCount => StatusList.Count(x => x.Type is ConsoleLineType.Error);
    public int WarningCount => StatusList.Count(x => x.Type is ConsoleLineType.Warning);
    public int InfoCount => StatusList.Count(x => x.Type is ConsoleLineType.Status);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (GameServers.FindByID(serverId) is not MCBedrockServer server)
            {
                Nav.NavigateTo("\\not-found");
                return;
            }

            Server = server;
            PlayerChart.AddRange([
                new()
                {
                    Name = "Active",
                    Data = PlayerCount_History,
                    Visible = true,
                }
            ]);

            // MetricChart.AddRange([
            //     new()
            //     {
            //         Name = "CPU",
            //         Data = CPU_History,
            //         Visible = true,
            //     }
            // ]);

            //MetricsService.Register(Server.ServerProcess);
            //MetricsService.MetricsUpdated += OnMetricsUpdated;
            //UpdateValue();

            MetricValues.First().NewValuePushed += (s, e) => InvokeAsync(StateHasChanged);
            Server.OutputList.CollectionChanged += (s, e) =>
            {
                var newErrors = e.NewItems.OfType<ConsoleLine>().Where(x => x.Type is ConsoleLineType.Error or ConsoleLineType.Warning or ConsoleLineType.Status);
                if (newErrors.Any())
                {
                    StatusList.AddRange(newErrors);
                    InvokeAsync(StateHasChanged);
                }
            };

            StatusList.Clear();
            StatusLines = new(StatusList);
            StatusLines.SetSort((a, b) => b.DateTime.CompareTo(a.DateTime));
            StatusList.AddRange(Server.OutputList.Where(x => x.Type is ConsoleLineType.Error or ConsoleLineType.Warning or ConsoleLineType.Status));
            
            StateHasChanged();
        }

        var startInterval = new System.TimeSpan(DateTime.Now.Hour + 1, 0, 0) - DateTime.Now.TimeOfDay;
        ChartTimer = new Timer(s => UpdateCharts(s), this, startInterval, TimeSpan.FromHours(1));
        UpdateCharts(this);
    }

    private async Task EditServerName()
    {var parameters = new DialogParameters
        {
            { nameof(EditTextDialog.Value), Server.Settings.Name }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Value", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string newValue)
        {
            Server.Settings.Name = newValue;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public ProcessMetricsList MetricValues { get; set; } =
    [
        new(ProcessMetricType.Cpu),
        new(ProcessMetricType.Memory),
        new(ProcessMetricType.DiskRead),
        new(ProcessMetricType.DiskWrite),
    ];

    //private ProcessMetricsSnapshot? _snapshot;

    //private List<ChartSeries<double>> MetricChart = new();

    private readonly TimeSeriesChartOptions ChartOptions = new()
    {
        YAxisLines = false,
        YAxisTicks = 10,
        YAxisRequireZeroPoint = true,
        XAxisLines = false,
        LineStrokeWidth = 1,
        ShowDataMarkers = false,
        TooltipTimeLabelFormat = "yyyy MMM dd HH:mm:ss",
        TimeLabelSpacing = TimeSpan.FromHours(1),
        XAxisTitle = "",
        YAxisTitle = "",
    };

    public static void PushValue<T>(T[] arr, T newValue)
    {
        Array.Copy(arr, 1, arr, 0, arr.Length - 1);
        arr[^1] = newValue;
    }

