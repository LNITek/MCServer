@page "/servers/{serverId}"
@inject NavigationManager Nav
@inject GameServers GameServers
@inject IJSRuntime JS

<PageTitle>MCServer - Overview</PageTitle>

<div style="flex-grow:1; overflow:auto;">
    <MudTabs Elevation="0" Rounded>
        <MudTabPanel Text="Status">

        </MudTabPanel>
        <MudTabPanel Text="Player Logs">

        </MudTabPanel>
        <MudTabPanel Text="Server Logs">

        </MudTabPanel>
        <MudTabPanel Text="Packet Statistics">

        </MudTabPanel>
    </MudTabs>
</div>

@code {
    [Parameter] public string serverId { get; set; } = "";
    public MCBedrockServer Server { get; set; }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (GameServers.FindByID(serverId) is not MCBedrockServer server)
            {
                Nav.NavigateTo("\\not-found");
                return;
            }

            Server = server;
            StateHasChanged();
        }
    }
}