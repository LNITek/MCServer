@page "/servers/{serverId}"
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject GameServers GameServers
@* @inject ProcessMetricsService MetricsService *@
@inject IJSRuntime JS

<PageTitle>MCServer - Overview</PageTitle>

<style>
    .dashboard-chart {
        min-height: 300px;
    }

    .dashboard-panel {
        min-height: 260px;
    }

    .h-100 {
        height: 100%;
    }

    .text-right {
        text-align: right;
    }
</style>

@if (Server is not null)
{
    <div style="flex-grow:1; overflow:auto; margin-right: -10px; padding-right: 10px;">
        <MudGrid Spacing="3">
            <!-- Header -->
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.h5" @ondblclick="EditServerName">@Server.Settings.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Server.Settings.Version
                            </MudText>
                        </div>

                        <div class="text-right">
                            <MudChip T="string"
                                     Color="@Server.ServerStatus.inticator"
                                     Variant="Variant.Filled">
                                @Server.ServerStatus.status
                            </MudChip>

                            <TimerLable StartedTime="@Server.StartupDate" Label="Uptime: " Class="mt-1"/>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Top metric cards -->
            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.Cpu"
                               Title="CPU"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.Cpu]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.Memory"
                               Title="Memory"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.Memory]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.DiskRead"
                               Title="Disk Read"
                               ShowProgress="false"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.DiskRead]" *@
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <ProcessMetric Process="@Server.ServerProcess"
                               Metric="ProcessMetricType.DiskWrite"
                               Title="Disk Write"
                               ShowProgress="false"/>
                @* @bind-Value="@MetricValues[ProcessMetricType.DiskWrite]" *@
            </MudItem>
            
            <!-- Performance graph -->
            @* <MudItem xs="12"> *@
            @*     <MudPaper Class="pa-4 dashboard-chart"> *@
            @*         <MudText Typo="Typo.h6">Server Performance</MudText> *@
            @* *@
            @*         <MudChart ChartType="ChartType.Timeseries" MatchBoundsToSize="true" *@
            @*                   ChartSeries="@MetricChart" *@
            @*                   ChartOptions="@ChartOptions" /> *@
            @*     </MudPaper> *@
            @* </MudItem> *@
            
            <!-- Player activity -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 dashboard-panel">
                    <MudText Typo="Typo.h6">Player Activity</MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Player count over the last 24 hours
                    </MudText>


                    <MudChart ChartType="ChartType.Timeseries" MatchBoundsToSize="true"
                              ChartSeries="@PlayerChart" ChartOptions="@ChartOptions"/>
                </MudPaper>
            </MudItem>

            <!-- Bottom status -->
            <MudItem xs="12">
                <MudPaper Class="pa-3">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Filled.Error" Color="Color.Error"/>
                                <MudText Color="Color.Error">
                                    @Errors.Count
                                </MudText>
                                <MudText Color="Color.Error">
                                    Errors
                                </MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <div style="flex-grow:1;">
                                <MudStack Spacing="2">
                                    @foreach (var item in Errors)
                                    {
                                        <MudText Color="@item.Colour">
                                            @(item.ToString())
                                        </MudText>
                                    }
                                </MudStack>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public string serverId { get; set; } = "";
    public MCBedrockServer Server { get; set; }

    public Timer ChartTimer;

    public Action<object?> UpdateCharts = (sender) =>
    {
        if (sender is not OverviewPage This) return;
        PushValue(This.PlayerCount_History, This.Server.PlayerList.Count);
        This.InvokeAsync(This.StateHasChanged);
    };

    private List<ChartSeries<int>> PlayerChart = new();
    public int[] PlayerCount_History = new int[24];

    public List<ConsoleLine> Errors { get; set; } = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (GameServers.FindByID(serverId) is not MCBedrockServer server)
            {
                Nav.NavigateTo("\\not-found");
                return;
            }

            Server = server;
            PlayerChart.AddRange([
                new()
                {
                    Name = "Active",
                    Data = PlayerCount_History,
                    Visible = true,
                }
            ]);

            // MetricChart.AddRange([
            //     new()
            //     {
            //         Name = "CPU",
            //         Data = CPU_History,
            //         Visible = true,
            //     }
            // ]);

            //MetricsService.Register(Server.ServerProcess);
            //MetricsService.MetricsUpdated += OnMetricsUpdated;
            //UpdateValue();

            MetricValues.First().NewValuePushed += (s, e) => InvokeAsync(StateHasChanged);
            Server.OutputList.CollectionChanged += (s, e) =>
            {
                var newErrors = e.NewItems.OfType<ConsoleLine>().Where(x => x.Type == ConsoleLineType.Error);
                if (newErrors.Any())
                {
                    Errors.AddRange(newErrors);
                    InvokeAsync(StateHasChanged);
                }
            };
            StateHasChanged();
        }

        var startInterval = new System.TimeSpan(DateTime.Now.Hour + 1, 0, 0) - DateTime.Now.TimeOfDay;
        ChartTimer = new Timer(s => UpdateCharts(s), this, startInterval, TimeSpan.FromHours(1));
        UpdateCharts(this);
    }

    private async Task EditServerName()
    {var parameters = new DialogParameters
        {
            { nameof(EditTextDialog.Value), Server.Settings.Name }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Value", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string newValue)
        {
            Server.Settings.Name = newValue;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public ProcessMetricsList MetricValues { get; set; } =
    [
        new(ProcessMetricType.Cpu),
        new(ProcessMetricType.Memory),
        new(ProcessMetricType.DiskRead),
        new(ProcessMetricType.DiskWrite),
    ];

    //private ProcessMetricsSnapshot? _snapshot;

    //private List<ChartSeries<double>> MetricChart = new();

    private readonly TimeSeriesChartOptions ChartOptions = new()
    {
        YAxisLines = false,
        YAxisTicks = 10,
        YAxisRequireZeroPoint = true,
        XAxisLines = false,
        LineStrokeWidth = 1,
        ShowDataMarkers = false,
        TooltipTimeLabelFormat = "yyyy MMM dd HH:mm:ss",
        TimeLabelSpacing = TimeSpan.FromHours(1),
        XAxisTitle = "",
        YAxisTitle = "",
    };

    public static void PushValue<T>(T[] arr, T newValue)
    {
        Array.Copy(arr, 1, arr, 0, arr.Length - 1);
        arr[^1] = newValue;
    }

