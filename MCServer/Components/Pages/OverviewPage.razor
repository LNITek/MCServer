@page "/servers/{serverId}"
@using System.Collections.ObjectModel
@using MCServer.Components.Dialogs
@using MCServer.Plugins
@implements IDisposable
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject GameServers GameServers
@inject PluginService Plugins
@inject SettingsService Settings
@inject IJSRuntime JS

<PageTitle>MCServer - Overview</PageTitle>

<style>
    .dashboard-chart {
        min-height: 300px;
    }

    .dashboard-panel {
        min-height: 260px;
    }

    .h-100 {
        height: 100%;
    }

    .text-right {
        text-align: right;
    }
</style>

@if (Server is not null)
{
    <div style="flex-grow:1; overflow:auto; margin-right: -10px; padding-right: 10px;">
        <MudGrid Spacing="3">
            <!-- Navigation -->
            <MudItem xs="6" md="10">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudStack Row="true" Wrap="Wrap.Wrap">
                        <MudTooltip Text="Documentation">
                            <MudMenu Icon="@Icons.Filled.Source" Variant="Variant.Outlined" Color="Color.Inherit">
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/files")" Icon="@Icons.Filled.Folder">Files</MudMenuItem>
                                @foreach (var docFile in Server.DocFiles)
                                {
                                    <MudMenuItem Href="@($"/docs/{Server.Settings.ID}/{docFile.Slug}")"
                                                 Icon="@docFile.Icon">
                                        @docFile.Title
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </MudTooltip>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/console")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Terminal">Console</MudButton>
                        <MudButton Href="@($"/servers/{Server.Settings.ID}/schedules")" Variant="Variant.Outlined" StartIcon="@Icons.Filled.Timer">Schedules</MudButton>
                        @foreach (var serverPage in _serverPages)
                        {
                            <MudButton Href="@($"/servers/{Server.Settings.ID}/p/{serverPage.Slug}")" Variant="Variant.Outlined" StartIcon="@serverPage.Icon">@serverPage.Title</MudButton>
                        }
                    </MudStack>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <div style="justify-content: start; display: flex;">
                        <MudMenu Label="Menus" EndIcon="@Icons.Filled.ArrowDropDown" Variant="Variant.Outlined"
                                 AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                            <MudMenu StartIcon="@Icons.Filled.Source" Label="Documentation">
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/files")" Icon="@Icons.Filled.Folder">Files</MudMenuItem>
                                @foreach (var docFile in Server.DocFiles)
                                {
                                    <MudMenuItem Href="@($"/docs/{Server.Settings.ID}/{docFile.Slug}")"
                                                 Icon="@docFile.Icon">
                                        @docFile.Title
                                    </MudMenuItem>
                                }
                            </MudMenu>
                            <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/console")" Icon="@Icons.Filled.Terminal">Console</MudMenuItem>
                            <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/schedules")" Icon="@Icons.Filled.Timer">Schedules</MudMenuItem>
                            @foreach (var serverPage in _serverPages)
                            {
                                <MudMenuItem Href="@($"/servers/{Server.Settings.ID}/p/{serverPage.Slug}")" Icon="@serverPage.Icon">@serverPage.Title</MudMenuItem>
                            }
                        </MudMenu>
                    </div>
                </MudHidden>
            </MudItem>
            <MudItem xs="6" md="2">
                <div style="justify-content: end; display: flex;">
                    <MudMenu Label="Commands" Color="Color.Primary" EndIcon="@Icons.Filled.ArrowDropDown" Variant="Variant.Filled"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem IconColor="Color.Error" Icon="@Icons.Filled.Delete" OnClick="DeleteServer">
                            Delete Server
                        </MudMenuItem>
                        
                        <CommandMenu Commands="@Server.Commands" OnExecute="@RunDisplayCommand"/>
                    </MudMenu>
                </div>
            </MudItem>

            <!-- Header -->
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.h5" @ondblclick="EditServerName">@Server.Settings.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Server.Settings.Type | @Server.Settings.Version
                            </MudText>
                        </div>

                        <div class="text-right">
                            <MudChip T="string"
                                     Color="@Server.ServerStatus.Indicator"
                                     Variant="Variant.Filled">
                                @Server.ServerStatus.Status
                            </MudChip>

                            <TimerLable StartedTime="@Server.StartupDate" Label="Uptime: " Class="mt-1"/>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Top metric cards -->
            @if (Server.ServerProcess is not null)
            {
                <MudItem xs="12" sm="6" md="3">
                    <ProcessMetric Process="@Server.ServerProcess"
                                   Metric="ProcessMetricType.Cpu"
                                   Title="CPU"/>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <ProcessMetric Process="@Server.ServerProcess"
                                   Metric="ProcessMetricType.Memory"
                                   Title="Memory"/>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <ProcessMetric Process="@Server.ServerProcess"
                                   Metric="ProcessMetricType.DiskRead"
                                   Title="Disk Read"
                                   ShowProgress="false"/>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <ProcessMetric Process="@Server.ServerProcess"
                                   Metric="ProcessMetricType.DiskWrite"
                                   Title="Disk Write"
                                   ShowProgress="false"/>
                </MudItem>
            }

            <!-- Player activity -->
            <MudItem xs="12">
                <MudPaper Class="pa-4 dashboard-panel">
                    <MudText Typo="Typo.h6">Player Activity</MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Player count over the last 24 hours
                    </MudText>


                    <MudChart ChartType="ChartType.Timeseries" MatchBoundsToSize="true"
                              ChartSeries="@PlayerChart" ChartOptions="@ChartOptions"/>
                </MudPaper>
            </MudItem>

            <!-- Bottom status -->
            <MudItem xs="12">
                <MudPaper Class="pa-3">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row Spacing="2" Breakpoint="Breakpoint.SmAndDown">
                                <MudStack Row Spacing="2">
                                    <MudIcon Icon="@Icons.Filled.Error" Color="Color.Error"/>
                                    <MudText Color="Color.Error">
                                        @ErrorCount
                                    </MudText>
                                    <MudText Color="Color.Error">
                                        Errors
                                    </MudText>
                                </MudStack>

                                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                    <MudDivider Vertical="true" FlexItem="true"/>
                                </MudHidden>

                                <MudStack Row Spacing="2">
                                    <MudIcon Icon="@Icons.Filled.Warning" Color="Color.Warning"/>
                                    <MudText Color="Color.Warning">
                                        @WarningCount
                                    </MudText>
                                    <MudText Color="Color.Warning">
                                        Warnings
                                    </MudText>
                                </MudStack>

                                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                                    <MudDivider Vertical="true" FlexItem="true"/>
                                </MudHidden>

                                <MudStack Row Spacing="2">
                                    <MudIcon Icon="@Icons.Filled.Info" Color="Color.Info"/>
                                    <MudText Color="Color.Info">
                                        @InfoCount
                                    </MudText>
                                    <MudText Color="Color.Info">
                                        Status
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <div style="flex-grow:1;">
                                <MudStack Spacing="2">
                                    @foreach (var item in StatusLines)
                                    {
                                        <MudText Color="@item.Colour">
                                            @(item.ToString())
                                        </MudText>
                                    }
                                </MudStack>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
}
else
{
    <PageLoading Text="Loading server..." />
}

@code {
    [Parameter] public string serverId { get; set; } = "";
    public IGameServer Server { get; set; } = null!;
    private List<ServerPageDefinition> _serverPages = [];
    private System.ComponentModel.PropertyChangedEventHandler? _propertyHandler;

    public void Dispose()
    {
        if (Server is not null && _propertyHandler is not null)
            Server.PropertyChanged -= _propertyHandler;
        ChartTimer?.Dispose();
    }

    public Timer ChartTimer = null!;

    public Action<object?> UpdateCharts = (sender) =>
    {
        if (sender is not OverviewPage This) return;
        PushValue(This.PlayerCount_History, This.Server.PlayerCount);
        This.InvokeAsync(This.StateHasChanged);
    };

    private List<ChartSeries<int>> PlayerChart = new();
    public int[] PlayerCount_History = new int[24];

    ObservableCollection<ConsoleLine> StatusList = [];
    public ExList<ConsoleLine> StatusLines { get; set; } = new([]);
    public int ErrorCount => StatusList.Count(x => x.Type is ConsoleLineType.Error);
    public int WarningCount => StatusList.Count(x => x.Type is ConsoleLineType.Warning);
    public int InfoCount => StatusList.Count(x => x.Type is ConsoleLineType.Status);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var server = GameServers.FindByID(serverId);
            if (server is null)
            {
                Nav.NavigateTo("\\not-found");
                return;
            }

            Server = server;
            _serverPages = Plugins.GetPages(Server).ToList();
            _propertyHandler = (_, _) => InvokeAsync(StateHasChanged);
            Server.PropertyChanged += _propertyHandler;

            PlayerChart.AddRange([
                new()
                {
                    Name = "Active",
                    Data = PlayerCount_History,
                    Visible = true,
                }
            ]);

            MetricValues.First().NewValuePushed += (s, e) => InvokeAsync(StateHasChanged);
            Server.OutputList.CollectionChanged += (s, e) =>
            {
                if (e.NewItems is null) return;
                var newErrors = e.NewItems.OfType<ConsoleLine>().Where(x => x.Type is ConsoleLineType.Error or ConsoleLineType.Warning or ConsoleLineType.Status);
                if (newErrors.Any())
                {
                    StatusList.AddRange(newErrors);
                    InvokeAsync(StateHasChanged);
                }
            };

            StatusList.Clear();
            StatusLines = new(StatusList);
            StatusLines.SetSort((a, b) => b.DateTime.CompareTo(a.DateTime));
            StatusList.AddRange(Server.OutputList.Where(x => x.Type is ConsoleLineType.Error or ConsoleLineType.Warning or ConsoleLineType.Status));

            StateHasChanged();
        }

        var startInterval = new System.TimeSpan(DateTime.Now.Hour + 1, 0, 0) - DateTime.Now.TimeOfDay;
        ChartTimer = new Timer(s => UpdateCharts(s), this, startInterval, TimeSpan.FromHours(1));
        UpdateCharts(this);
    }

    private void RunDisplayCommand(ServerCommand command)
    {
        Server.RunCommand(command.Name);
    }

    private async Task DeleteServer()
    {
        if (Server is null) return;

        if (Server.ServerRunningStatus)
        {
            Program.NotifyUser("Stop the server before deleting it.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(ConfirmationDialog.Message), "Are you sure you want to delete the server? Everything under the server path will be deleted!\r\nThis action can not be undone!" },
            { nameof(ConfirmationDialog.ValidateKey), Server.Settings.ID },
        };
        var options = new DialogOptions { CloseOnEscapeKey = true,  };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Delete - " + Server.Settings.Name, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            if (_propertyHandler is not null)
                Server.PropertyChanged -= _propertyHandler;
            _propertyHandler = null;

            Server.Delete();
            GameServers.Unregister(Server);
            Settings.RemoveServer(Server.Settings.ID);
            Program.NotifyUser($"Server '{Server.Settings.Name}' deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Program.NotifyUser($"Delete failed: {ex.Message}", Severity.Error);
            return;
        }

        Nav.NavigateTo("/");
    }
    
    private async Task EditServerName()
    {
        var parameters = new DialogParameters
        {
            { nameof(EditTextDialog.Value), Server.Settings.Name }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<EditTextDialog>("Edit Value", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string newValue)
        {
            if (string.IsNullOrWhiteSpace(newValue))
            {
                Program.NotifyUser("Server name cannot be empty.", Severity.Error);
                return;
            }

            Server.Settings.Name = newValue.Trim();
            Settings.Save();
            Program.NotifyUser("Server name saved.", Severity.Success);
            InvokeAsync(StateHasChanged);
        }
    }

    public ProcessMetricsList MetricValues { get; set; } =
    [
        new(ProcessMetricType.Cpu),
        new(ProcessMetricType.Memory),
        new(ProcessMetricType.DiskRead),
        new(ProcessMetricType.DiskWrite),
    ];

    private readonly TimeSeriesChartOptions ChartOptions = new()
    {
        YAxisLines = false,
        YAxisTicks = 10,
        YAxisRequireZeroPoint = true,
        XAxisLines = false,
        LineStrokeWidth = 1,
        ShowDataMarkers = false,
        TooltipTimeLabelFormat = "yyyy MMM dd HH:mm:ss",
        TimeLabelSpacing = TimeSpan.FromHours(1),
        XAxisTitle = "",
        YAxisTitle = "",
    };

    public static void PushValue<T>(T[] arr, T newValue)
    {
        Array.Copy(arr, 1, arr, 0, arr.Length - 1);
        arr[^1] = newValue;
    }
}
