@page "/player-settings"
@implements IDisposable
@inject MCBedrockServer Server
@using System.Collections.ObjectModel

<PageTitle>MCServer - Player Settings</PageTitle>

<style>
    .mud-input-control {
        border: 0;
        margin: 0;
        padding: 0;
        display: flex;
        flex: 0 1 auto;
        max-width: 100%;
        position: relative;
        flex-direction: column;
        vertical-align: top;
    }

    .mud-select {
        display: flex;
        flex-grow: 0;
        position: relative;
    }
</style>

<div style="height:100%; display:flex; flex-direction:row;">
    <MudStack Spacing="3" Style="min-width:25%; max-width:30%; width: 100%;">
        <MudTextField T="string" @bind-Value="SearchText" Placeholder="Search..." Clearable Variant="Variant.Outlined"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Rounded.Search" OnAdornmentClick="@Search"
                      TextChanged="@(s => Search(s))">
        </MudTextField>

        <MudList T="Player" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="SelectedPlayer" Style="overflow:auto; height:100%">
            @foreach (var player in Players)
            {
                <MudListItem Value="@player">
                    <ChildContent>
                        <MudStack Spacing="1" Row AlignItems="AlignItems.Center">
                            <MudChip Color="@player.PlayerLimitColour" Text="@player.Permissions.ToString()"/>

                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6">@player.Name</MudText>
                                <MudText Typo="Typo.body2">@player.Xuid</MudText>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Rounded.Add" OnClick="AddPlayer_Click">Add Player</MudButton>
    </MudStack>

    <MudDivider Vertical Class="mx-4" />

    <MudStack Style="flex-grow:1; overflow:auto;">
        <MudAlert Variant="Variant.Text" Severity="Severity.Warning">These changes is only in an effect after a restart!</MudAlert>

        @if (SelectedPlayer is not null)
        {
            <MudTextField Variant="Variant.Outlined" T="string" Label="Name" @bind-Value="SelectedPlayer.Name"></MudTextField>
            <MudTextField Variant="Variant.Outlined" T="string" Label="XUID" @bind-Value="SelectedPlayer.Xuid"></MudTextField>

            <MudText Typo="Typo.h6">Properties</MudText>
            <MudSelect Variant="Variant.Outlined" T="PlayerPermission" Label="Permission" @bind-Value="SelectedPlayer.Permissions" FullWidth>
                @foreach (var permission in Enum.GetValues<PlayerPermission>())
                {
                    <MudSelectItem Value="permission">@permission.ToString()</MudSelectItem>
                }
            </MudSelect>

            <MudStack Spacing="1" Row AlignItems="AlignItems.Center">
                <MudCheckBox T="bool" @bind-Value="SelectedPlayer.WhiteList" Label="Add to allow list" />
                <MudSwitch T="bool" @bind-Value="SelectedPlayer.IgnoresPlayerLimit" Label="Ignores Player Limit" Disabled="@(!SelectedPlayer.WhiteList)" />
            </MudStack>
        } else
        {
            <MudAlert Variant="Variant.Text" Severity="Severity.Info">Select a player or create a new one.</MudAlert>
        }
    </MudStack>
</div>

@code {
    public ObservableCollection<Player> PlayersList = [];
    public ExList<Player> Players;
    public string SearchText { get; set; } = string.Empty;
    public Player? SelectedPlayer = default;

    public PlayerSettingPage()
    {
        Players = new(PlayersList);
        Players.SetSort((a, b) => a.Xuid.CompareTo(b.Xuid));
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        PlayersList.AddRange(Server.GetPlayers());
        SelectedPlayer = PlayersList.FirstOrDefault();
        Players.SetFilter(filter =>
        {
            if (string.IsNullOrWhiteSpace(SearchText)) return true;
            return filter.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                filter.Xuid.Contains(SearchText, StringComparison.OrdinalIgnoreCase);
        });
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Save();
    }
    
    private void Save()
    {
        Server.SetPlayers(PlayersList);
        Server.RefreshPlayerProperties();
    }

    private void AddPlayer_Click()
    {
        PlayersList.Add(new());
        SelectedPlayer = PlayersList.LastOrDefault();
        StateHasChanged();
    }

    private void DeleteProperty_Click()
    {
        PlayersList.Remove(SelectedPlayer);
        SelectedPlayer = null;
        Save();
        StateHasChanged();
    }
    private void Search(string value)
    {
        SearchText = value;
        Search();
    }

    private void Search()
    {
        Players.RefreshFilter();
        StateHasChanged();
    }
}