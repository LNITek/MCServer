@* Shared metric display used for both server metrics (ProcessMetric)
   and host metrics (HostMetric). Styled after the dashboard summary cards. *@

<MudPaper Class="pa-4" Elevation="2" Style="height:100%;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <MudAvatar Color="@AvatarColor" Variant="Variant.Filled">
                <MudIcon Icon="@Icon" />
            </MudAvatar>
        }
        <div style="min-width:0;">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Title</MudText>
            <MudText Typo="Typo.h6" Style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@DisplayValue</MudText>
        </div>
        @if (ShowCircular)
        {
            <MudSpacer />
            <MudProgressCircular Value="@Progress" Size="Size.Medium" Color="@AvatarColor" />
        }
    </MudStack>

    @if (ShowProgress)
    {
        <MudProgressLinear Value="@Progress"
                           Color="@AvatarColor"
                           Rounded="true"
                           Size="Size.Small"
                           Class="mt-2" />
    }
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string DisplayValue { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public Color AvatarColor { get; set; } = Color.Primary;

    /// <summary>0-100 value for the circular gauge / linear bar.</summary>
    [Parameter]
    public double Progress { get; set; }

    [Parameter]
    public bool ShowProgress { get; set; }

    [Parameter]
    public bool ShowCircular { get; set; }
}
